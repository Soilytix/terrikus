# Converge editors before any formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_style = tab

# Trailing whitespace is meaningful in Markdown (hard line break).
[*.md]
trim_trailing_whitespace = false
