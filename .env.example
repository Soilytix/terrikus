# Copy to .env (gitignored); mise loads it for every task.
# Nothing here is secret: Soil Worlds is a static build with no network calls.

# --- vite.config.ts, tests/profile.test.ts -------------------------------------
# Build profile. `internal` (default) ships every content node and shows a
# "Scientific review pending" badge on anything not approved. `public` ships
# only approved content and publicOk assets, and its gate fails otherwise.
SW_PROFILE=internal # not secret

# --- tools/hash-denylist.ts ---------------------------------------------------
# Path to the plain-text customer/variety denylist, one token per line. It lives
# OUTSIDE the repo; only its SHA-256 hashes are committed (tests/denylist-hashes.json).
SW_DENYLIST_FILE= # not secret, but the file it points at is confidential
